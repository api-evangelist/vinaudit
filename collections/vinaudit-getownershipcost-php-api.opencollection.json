            "params": [
              {
                "name": "vin",
                "value": "",
                "type": "query",
                "description": "17-character Vehicle Identification Number"
              },
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "API authentication key"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Two-letter US state code for location-specific tax and fee calculation"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format"
              }
            ]
          },
          "docs": "Calculate the estimated 5-year total cost of ownership for a vehicle identified by VIN. Returns itemized yearly cost arrays for depreciation, insurance, fuel, maintenance, repairs, and state fees/taxes, plus a cumulative 5-year total. The state parameter is required to apply location-specific fee and tax calculations."
        },
        {
